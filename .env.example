# SPManchester Private Limited - Environment Configuration
# Website: https://www.spmanchester.com | Contact: info@spmanchester.com

APP_ENV=production
APP_TIMEZONE=Asia/Karachi
APP_DEBUG=false

# Admin Authentication
ADMIN_USERNAME=admin
# Generate hash via: php -r 'echo password_hash("YOUR_PASSWORD", PASSWORD_DEFAULT);'
ADMIN_PASSWORD_HASH=REPLACE_WITH_BCRYPT_HASH

# Meta WhatsApp Cloud API Credentials
META_GRAPH_VERSION=v21.0
META_PHONE_NUMBER_ID=YOUR_META_PHONE_NUMBER_ID
META_ACCESS_TOKEN=YOUR_SYSTEM_USER_ACCESS_TOKEN
META_APP_SECRET=YOUR_META_APP_SECRET
META_WEBHOOK_VERIFY_TOKEN=YOUR_RANDOM_VERIFICATION_TOKEN

# Campaign Financial & Rate-Limit Safeguards
ENABLE_LIVE_SENDING=false
ESTIMATED_COST_PER_MESSAGE=13.10
CAMPAIGN_BUDGET_LIMIT=40000.00
MAX_DISPATCH_PER_RUN=25
DEFAULT_DAILY_LIMIT=500
